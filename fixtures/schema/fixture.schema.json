{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:projectcyborg:cyborgheart:fixture:v1",
  "title": "CyborgHeart event-application fixture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixture_schema_version",
    "id",
    "title",
    "description",
    "status",
    "minimum_stage",
    "matrix",
    "provenance",
    "input",
    "facts",
    "budget",
    "expect"
  ],
  "properties": {
    "fixture_schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$",
      "minLength": 3
    },
    "title": {
      "type": "string",
      "minLength": 3
    },
    "description": {
      "type": "string",
      "minLength": 10
    },
    "status": {
      "enum": [
        "active",
        "planned"
      ]
    },
    "minimum_stage": {
      "enum": [
        "contract",
        "verified-intake",
        "linear-application",
        "complete-v12"
      ]
    },
    "matrix": {
      "$ref": "#/$defs/matrix"
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "input": {
      "$ref": "#/$defs/input"
    },
    "facts": {
      "$ref": "#/$defs/facts"
    },
    "budget": {
      "$ref": "#/$defs/budget"
    },
    "expect": {
      "$ref": "#/$defs/expect"
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      },
      "uniqueItems": true
    }
  },
  "$defs": {
    "matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "spec_version",
        "room_version",
        "references"
      ],
      "properties": {
        "spec_version": {
          "const": "1.19"
        },
        "room_version": {
          "type": "string",
          "minLength": 1
        },
        "references": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source",
        "license"
      ],
      "properties": {
        "kind": {
          "enum": [
            "authored",
            "matrix-spec",
            "ruma",
            "regression"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 3
        },
        "license": {
          "type": "string",
          "minLength": 3
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "room_version",
        "provenance",
        "key_validity_reference_ts"
      ],
      "properties": {
        "mode": {
          "enum": [
            "raw-json",
            "canonical-object"
          ]
        },
        "raw_json": {
          "type": "string"
        },
        "candidate": {
          "type": "object"
        },
        "asserted_event_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "room_version": {
          "type": "string",
          "minLength": 1
        },
        "provenance": {
          "enum": [
            "federated",
            "locally-constructed",
            "replay",
            "import"
          ]
        },
        "key_validity_reference_ts": {
          "type": "integer",
          "minimum": 0
        },
        "options": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "evidence_level": {
              "const": "standard"
            }
          },
          "required": [
            "evidence_level"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "mode": {
                "const": "raw-json"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "raw_json"
            ],
            "not": {
              "required": [
                "candidate"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "mode": {
                "const": "canonical-object"
              }
            },
            "required": [
              "mode"
            ]
          },
          "then": {
            "required": [
              "candidate"
            ],
            "not": {
              "required": [
                "raw_json"
              ]
            }
          }
        }
      ]
    },
    "event_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "event",
        "disposition"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 2
        },
        "event": {
          "type": "object"
        },
        "disposition": {
          "enum": [
            "accepted",
            "rejected",
            "soft-failed",
            "unevaluated"
          ]
        }
      }
    },
    "state_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "state_key",
        "event_id"
      ],
      "properties": {
        "type": {
          "type": "string"
        },
        "state_key": {
          "type": "string"
        },
        "event_id": {
          "type": "string"
        }
      }
    },
    "state_after_fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "entries"
      ],
      "properties": {
        "event_id": {
          "type": "string"
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_entry"
          }
        }
      }
    },
    "current_state_fact": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "room_id",
        "revision",
        "entries"
      ],
      "properties": {
        "room_id": {
          "type": "string"
        },
        "revision": {
          "type": "string",
          "minLength": 1
        },
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_entry"
          }
        }
      }
    },
    "signing_key": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "server",
        "key_id",
        "public_key"
      ],
      "properties": {
        "server": {
          "type": "string"
        },
        "key_id": {
          "type": "string"
        },
        "public_key": {
          "type": "string"
        },
        "valid_from_ts": {
          "type": "integer",
          "minimum": 0
        },
        "valid_until_ts": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "policy_recommendation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event_id",
        "policy_event_id",
        "policy_fingerprint",
        "outcome"
      ],
      "properties": {
        "event_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_event_id": {
          "type": "string",
          "minLength": 1
        },
        "policy_fingerprint": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "server",
                "key_id",
                "signature"
              ],
              "properties": {
                "kind": {
                  "const": "signature-material"
                },
                "server": {
                  "type": "string",
                  "minLength": 1
                },
                "key_id": {
                  "type": "string",
                  "minLength": 1
                },
                "signature": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind"
              ],
              "properties": {
                "kind": {
                  "const": "final-unavailable"
                }
              }
            }
          ]
        }
      }
    },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "events",
        "state_after",
        "current_room_state",
        "signing_keys",
        "policy_recommendations"
      ],
      "properties": {
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/event_fact"
          }
        },
        "state_after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/state_after_fact"
          }
        },
        "current_room_state": {
          "$ref": "#/$defs/current_state_fact"
        },
        "signing_keys": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/signing_key"
          }
        },
        "policy_recommendations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/policy_recommendation"
          }
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "canonical_json_bytes": {
          "type": "integer",
          "minimum": 0
        },
        "events_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "state_entries_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "auth_events_inspected": {
          "type": "integer",
          "minimum": 0
        },
        "auth_chain_edges": {
          "type": "integer",
          "minimum": 0
        },
        "graph_edges": {
          "type": "integer",
          "minimum": 0
        },
        "signature_verifications": {
          "type": "integer",
          "minimum": 0
        },
        "state_resolution_steps": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "stage",
        "details"
      ],
      "properties": {
        "code": {
          "enum": [
            "need.event",
            "need.state_after",
            "need.current_room_state",
            "need.signing_keys",
            "need.policy_recommendation"
          ]
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "details": {
          "type": "object"
        }
      }
    },
    "stage": {
      "enum": [
        "room_version_admission",
        "canonical_input",
        "pdu_format",
        "event_identity",
        "signer_discovery",
        "cryptographic_verification",
        "state_independent_auth",
        "claimed_auth",
        "state_before",
        "historical_auth",
        "current_state_auth",
        "policy_server",
        "consequences"
      ]
    },
    "work_expectation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max"
      ],
      "properties": {
        "max": {
          "$ref": "#/$defs/budget"
        }
      }
    },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "code",
        "stage",
        "dependencies",
        "consequences",
        "work"
      ],
      "properties": {
        "kind": {
          "enum": [
            "input-error",
            "capability-error",
            "complete",
            "needs-dependencies",
            "halted",
            "fault"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
        },
        "stage": {
          "$ref": "#/$defs/stage"
        },
        "disposition": {
          "enum": [
            "accepted",
            "dropped",
            "rejected",
            "soft-failed"
          ]
        },
        "details": {
          "type": "object"
        },
        "dependencies": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dependency"
          }
        },
        "consequences": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^consequence\\.[a-z][a-z0-9_]*$"
          }
        },
        "work": {
          "$ref": "#/$defs/work_expectation"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "complete"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "disposition"
            ]
          },
          "else": {
            "not": {
              "required": [
                "disposition"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "needs-dependencies"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "dependencies": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "dependencies": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}
